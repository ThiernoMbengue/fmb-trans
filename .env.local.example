NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète (Supabase > Project Settings > API > service_role).
# Ne jamais préfixer par NEXT_PUBLIC_ : elle ne doit jamais être visible côté navigateur.
# Utilisée uniquement par la page "Comptes" pour créer/supprimer des connexions.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
