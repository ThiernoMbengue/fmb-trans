NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète (Supabase > Project Settings > API > service_role).
# Ne jamais préfixer par NEXT_PUBLIC_ : elle ne doit jamais être visible côté navigateur.
# Utilisée uniquement par la page "Comptes" pour créer/supprimer des connexions.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Espace investisseur (/investisseur) ---
# Mot de passe d'accès. À définir ici : la valeur par défaut du code ("yango")
# est publique puisque le dépôt l'est. Changez-la pour un mot de passe réel.
INVESTOR_PASSWORD=yango
# Véhicule présenté dans le dossier investisseur (immatriculation exacte)
INVESTOR_VEHICLE_IMMAT=AB-449-JL
# Prix d'achat du véhicule, en FCFA
INVESTOR_PRIX_ACHAT=6500000
